generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  user_id                 String                  @id @default(uuid()) @db.Uuid
  username                String                  @unique
  email                   String                  @unique
  password                String
  nickname                String
  age                     Int?
  profile_image           String?
  reading_style           Json?
  reading_habit           Json?
  favorite_genre          Json?
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt

  // ---- 아래 5개 게이미피케이션 컬럼 신규 추가 ----
  points                  Int                     @default(0)
  exp                     Int                     @default(0)
  level                   Int                     @default(1)
  active_character_id     String?                 @db.Uuid
  active_character        Character?              @relation(fields: [active_character_id], references: [character_id])

  ai_goal_recommendations AiGoalRecommendation[]
  bookshelves             Bookshelf[]
  bookshelf_folders       BookshelfFolder[]
  calendar_records        CalendarRecord[]
  checklists              Checklist[]
  focus_logs              FocusLog[]
  group_members           GroupMember[]
  created_groups          Group[]                 @relation("GroupCreator")
  guidebooks              Guidebook[]
  notifications           Notification[]
  rankings                Ranking[]
  reading_goals           ReadingGoal[]
  reading_room_users      ReadingRoomUser[]
  reading_rooms           ReadingRoom[]           @relation("RoomStarter")
  refresh_tokens          RefreshToken[]
  thread_replies          ThreadReply[]
  threads                 Thread[]

  @@map("users")
}

model RefreshToken {
  token_id      String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  refresh_token String
  expired_at    DateTime?
  created_at    DateTime  @default(now())
  user          User      @relation(fields: [user_id], references: [user_id])

  @@map("refresh_tokens")
}

model Book {
  book_id       String        @id @default(uuid()) @db.Uuid
  title         String
  author        String?
  isbn          String?
  book_category String?
  cover_url     String?
  total_pages   Int?
  book_intro    String?
  source        String?
  bookshelves   Bookshelf[]
  checklists    Checklist[]
  folder_books  FolderBook[]
  group_books   GroupBook[]
  reading_goals ReadingGoal[]
  reading_rooms ReadingRoom[]
  threads       Thread[]

  @@map("books")
}

model Bookshelf {
  bookshelf_id String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  book_id      String   @db.Uuid
  status       Int?
  current_page Int?
  progress     Float?
  created_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])
  book Book @relation(fields: [book_id], references: [book_id])

  @@map("bookshelf")
}

model BookshelfFolder {
  folder_id    String         @id @default(uuid()) @db.Uuid
  user_id      String         @db.Uuid
  folder_name  String
  folder_image String?
  created_at   DateTime       @default(now())
  user         User           @relation(fields: [user_id], references: [user_id])
  folder_books FolderBook[]

  @@map("bookshelf_folders")
}

model FolderBook {
  folder_book_id String          @id @default(uuid()) @db.Uuid
  folder_id      String          @db.Uuid
  book_id        String          @db.Uuid
  book           Book            @relation(fields: [book_id], references: [book_id])
  folder         BookshelfFolder @relation(fields: [folder_id], references: [folder_id])

  @@map("folder_books")
}

model Group {
  group_id      String        @id @default(uuid()) @db.Uuid
  group_name    String
  people_count  Int?
  invite_code   String?
  created_by    String        @db.Uuid
  created_at    DateTime      @default(now())
  group_books   GroupBook[]
  group_members GroupMember[]
  creator       User          @relation("GroupCreator", fields: [created_by], references: [user_id])
  reading_rooms ReadingRoom[]
  threads       Thread[]

  @@map("groups")
}

model GroupMember {
  group_member_id String   @id @default(uuid()) @db.Uuid
  group_id        String   @db.Uuid
  user_id         String   @db.Uuid
  role            Int?
  joined_at       DateTime @default(now())

  group Group @relation(fields: [group_id], references: [group_id])
  user  User  @relation(fields: [user_id], references: [user_id])

  @@map("group_members")
}

model GroupBook {
  group_book_id String    @id @default(uuid()) @db.Uuid
  group_id      String    @db.Uuid
  book_id       String    @db.Uuid
  target_date   DateTime? @db.Date
  created_at    DateTime  @default(now())

  group Group @relation(fields: [group_id], references: [group_id])
  book  Book  @relation(fields: [book_id], references: [book_id])

  @@map("group_books")
}

model ReadingRoomUser {
  room_user_id  String        @id @default(uuid())
  room_id       String        @db.Uuid
  user_id       String        @db.Uuid
  entered_at    DateTime?
  exited_at     DateTime?
  status        String        @default("reading") // 미디어파이프 연산 결과 저장 
  reading_rooms ReadingRoom @relation(fields: [room_id], references: [room_id])
  users         User          @relation(fields: [user_id], references: [user_id])
  
  @@map("reading_room_users") // 실제 DB에는 소문자 스네이크 케이스로 생성됨
}

model ReadingRoom {
  room_id             String               @id @default(uuid()) @db.Uuid
  group_id            String?              @db.Uuid
  book_id             String?              @db.Uuid
  started_by          String               @db.Uuid
  max_users           Int                  @default(6)
  is_active           Boolean              @default(true)
  room_name           String
  started_at          DateTime?
  ended_at            DateTime?
  focus_logs          FocusLog[]
  ReadingRoomUser     ReadingRoomUser[]

  // 관계 타겟 타입
  books               Book?                @relation(fields: [book_id], references: [book_id])
  groups              Group?               @relation(fields: [group_id], references: [group_id])
  users               User                 @relation("RoomStarter", fields: [started_by], references: [user_id])
  
  @@map("reading_rooms") // 실제 DB에는 소문자 스네이크 케이스로 생성됨
}

model FocusLog {
  focus_log_id String   @id @default(uuid()) @db.Uuid
  room_id      String   @db.Uuid
  user_id      String   @db.Uuid
  status       String?
  focus_score  Float?
  created_at   DateTime @default(now())

  room ReadingRoom @relation(fields: [room_id], references: [room_id])
  user User        @relation(fields: [user_id], references: [user_id])

  @@map("focus_logs")
}

model Thread {
  thread_id           String          @id @default(uuid()) @db.Uuid
  user_id             String          @db.Uuid
  book_id             String          @db.Uuid
  group_id            String?         @db.Uuid
  content             String
  current_page        Int?
  is_public           Boolean         @default(true)
  likes               Int             @default(0)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  ai_thread_summaries AiThreadSummary[]
  thread_replies      ThreadReply[]
  book                Book            @relation(fields: [book_id], references: [book_id])
  group               Group?          @relation(fields: [group_id], references: [group_id])
  user                User            @relation(fields: [user_id], references: [user_id])

  @@map("threads")
}

model ThreadReply {
  reply_id     String   @id @default(uuid()) @db.Uuid
  thread_id    String   @db.Uuid
  user_id      String   @db.Uuid
  content      String
  current_page Int?
  is_public    Boolean  @default(true)
  created_at   DateTime @default(now())

  thread Thread @relation(fields: [thread_id], references: [thread_id])
  user   User   @relation(fields: [user_id], references: [user_id])

  @@map("thread_replies")
}

model ReadingGoal {
  goal_id        String      @id @default(uuid()) @db.Uuid
  user_id        String      @db.Uuid
  book_id        String      @db.Uuid
  start_date     DateTime?   @db.Date
  end_date       DateTime?   @db.Date
  period         Int?
  daily_pages    Int?
  preferred_days Json?
  status         Int?
  created_at     DateTime    @default(now())
  checklists     Checklist[]
  book           Book        @relation(fields: [book_id], references: [book_id])
  user           User        @relation(fields: [user_id], references: [user_id])

  @@map("reading_goals")
}

model Checklist {
  checklist_id String       @id @default(uuid()) @db.Uuid
  user_id      String       @db.Uuid
  book_id      String?      @db.Uuid
  goal_id      String?      @db.Uuid
  goal_content String
  daily_pages  Int?
  date         DateTime?    @db.Date
  check_box    Boolean      @default(false)
  checked_at   DateTime?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  book         Book?        @relation(fields: [book_id], references: [book_id])
  goal         ReadingGoal? @relation(fields: [goal_id], references: [goal_id])
  user         User         @relation(fields: [user_id], references: [user_id])

  @@map("checklists")
}

model CalendarRecord {
  calendar_id String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  date        DateTime @db.Date
  pages       Int?
  has_long    Boolean  @default(false)
  level       Int?
  is_done     Boolean  @default(false)
  has_paw     Boolean  @default(false)

  user User @relation(fields: [user_id], references: [user_id])

  @@map("calendar_records")
}

model AiThreadSummary {
  summary_id   String   @id @default(uuid()) @db.Uuid
  thread_id    String   @db.Uuid
  book_id      String   @db.Uuid
  summary      String?
  key_insights Json?
  created_at   DateTime @default(now())
  thread       Thread   @relation(fields: [thread_id], references: [thread_id])

  @@map("ai_thread_summaries")
}

model AiGoalRecommendation {
  recommendation_id       String   @id @default(uuid()) @db.Uuid
  user_id                 String   @db.Uuid
  recommended_daily_pages Int?
  preferred_days          Json?
  recommended_period      Int?
  habit_tips              Json?
  created_at              DateTime @default(now())
  user                    User     @relation(fields: [user_id], references: [user_id])

  @@map("ai_goal_recommendations")
}

model Ranking {
  ranking_id  String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  period      String?
  scope       String?
  total_pages Int?
  rank        Int?
  percentile  Float?
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@map("rankings")
}

model Notification {
  notification_id String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  type            String?
  title           String?
  content         String?
  is_read         Boolean   @default(false)
  scheduled_at    DateTime?
  sent_at         DateTime?
  created_at      DateTime  @default(now())
  user            User      @relation(fields: [user_id], references: [user_id])

  @@map("notifications")
}

model Guidebook {
  guidebook_id String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  animal_name  String?
  success      Int?
  animal_img   String?
  acquired_at  DateTime?
  user         User      @relation(fields: [user_id], references: [user_id])

  @@map("guidebooks")
}

// ==========================================
// [신규] 포인트 시스템 (적립/차감 원장)
// ==========================================
model PointLog {
  point_log_id String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid // User 모델과 명시적 relation 없음 (스키마 충돌 방지)
  amount       Int      // 양수 = 적립, 음수 = 차감
  reason       String   // 'CHECKLIST_COMPLETE' | 'CHECKLIST_CANCEL' | 'CHARACTER_PURCHASE' 등
  created_at   DateTime @default(now())

  @@index([user_id])
  @@map("point_logs")
}

// ==========================================
// [신규] 경험치 원장 (적립 이력)
// ==========================================
model ExpLog {
  exp_log_id String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid // User 모델과 명시적 relation 없음 (PointLog와 동일 패턴)
  amount     Int
  reason     String   // 'CHECKLIST_COMPLETE' | 'FOCUS_SESSION' | 'DAILY_QUEST' | 'WEEKLY_QUEST' 등
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("exp_logs")
}

// ==========================================
// [신규] 레벨업 임계치 테이블 (누적 경험치 기준)
// ==========================================
model LevelThreshold {
  level        Int     @id
  required_exp Int     @unique // 이 경험치 이상이면 해당 레벨 달성
  level_name   String? // "새싹 독서가" 같은 표시용 이름 (선택)

  @@map("level_thresholds")
}

// ==========================================
// [신규] 칭호 마스터 카탈로그 (레벨 도달 시 자동 해금)
// ==========================================
model Title {
  title_id       String   @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  required_level Int      // 이 레벨 이상이면 획득 처리
  image_url      String?
  created_at     DateTime @default(now())

  representative_settings UserRepresentativeTitle[]

  @@map("titles")
}

// ==========================================
// [신규] 유저별 대표 칭호 (진짜 1:1 — PK가 user_id 자체)
// ==========================================
model UserRepresentativeTitle {
  user_id    String   @id @db.Uuid // PK = user_id → 유저당 정확히 1행만 존재 강제
  title_id   String   @db.Uuid
  updated_at DateTime @updatedAt

  title Title @relation(fields: [title_id], references: [title_id])

  @@map("user_representative_titles")
}

// ==========================================
// [신규] 캐릭터 카탈로그 (포인트로만 구매)
// ==========================================
model Character {
  character_id String          @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  price        Int             // 포인트 가격
  image_url    String?
  created_at   DateTime        @default(now())

  owners       UserCharacter[]
  active_users User[]          // active_character_id로 이 캐릭터를 장착 중인 유저들

  @@map("characters")
}

// ==========================================
// [신규] 유저-캐릭터 소유 관계 (구매 이력, 복합 PK)
// ==========================================
model UserCharacter {
  user_id      String    @db.Uuid // User 모델과 명시적 relation 없음 (PointLog와 동일 패턴)
  character_id String    @db.Uuid
  purchased_at DateTime  @default(now())

  character    Character @relation(fields: [character_id], references: [character_id])

  @@id([user_id, character_id]) // 복합 PK → 같은 캐릭터 중복 구매를 DB가 원천 차단
  @@index([user_id])
  @@map("user_characters")
}

// ==========================================
// [신규] 퀘스트 마스터 (일일 / 주간)
// ==========================================
model Quest {
  quest_id       String      @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  quest_type     String      // 'DAILY' | 'WEEKLY'
  condition_type String      // 'READING_ROOM_JOIN' | 'CHECKLIST_COMPLETE' 등
  goal_count     Int
  reward_exp     Int         @default(0)
  reward_points  Int         @default(0)
  created_at     DateTime    @default(now())

  user_quests    UserQuest[]

  @@map("quests")
}

// ==========================================
// [신규] 유저별 퀘스트 진행 상황
// ==========================================
model UserQuest {
  user_quest_id String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid // User 모델과 명시적 relation 없음 (PointLog와 동일 패턴)
  quest_id      String    @db.Uuid
  current_count Int       @default(0)
  is_completed  Boolean   @default(false)
  reset_date    DateTime  @db.Date // 일일/주간 리셋 기준 날짜
  completed_at  DateTime?
  created_at    DateTime  @default(now())

  quest         Quest     @relation(fields: [quest_id], references: [quest_id])

  @@index([user_id])
  @@map("user_quests")
}
